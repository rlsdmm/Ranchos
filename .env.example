# Copie estes nomes para as Environment Variables do Render
SITE_NAME=Ranchos da Represa
CITY_NAME=Nome da Sua Cidade
ADMIN_PASSWORD=troque-por-uma-senha-forte
SECRET_KEY=cole-aqui-um-texto-aleatorio-longo
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
BASE_URL=https://seudominio.com.br
# WhatsApp do site (para pedidos de cozinheira/faxina). Deixe vazio para esconder essa parte.
SITE_WHATSAPP=16999999999
# Bunny Storage para as fotos (deixe vazio para guardar as fotos no banco).
# Migrar fotos antigas do banco: flask --app app fotos-para-bunny
BUNNY_STORAGE_URL=https://br.storage.bunnycdn.com/nome-da-zona
BUNNY_STORAGE_KEY=senha-da-storage-zone
BUNNY_CDN_URL=https://nome-da-zona.b-cdn.net
